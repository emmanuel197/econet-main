# Git LFS — heavy binary assets stored outside normal git history.
# After cloning: run `git lfs pull` to download the real files.
# See /assets/README.md for the naming convention and SVG-vs-WebP rule.

*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.pdf  filter=lfs diff=lfs merge=lfs -text

# SVGs are NOT in LFS — every SVG in this repo is a tiny (<3KB) optimized icon,
# kept as normal diffable git text. Cutoff for promoting an SVG to LFS: 20KB.
# If a future SVG exceeds that, add an explicit path rule here, e.g.:
#   assets/illustrations/some-huge-illustration.svg filter=lfs diff=lfs merge=lfs -text
